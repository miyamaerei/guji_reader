{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reader-vue/book.config.schema.json",
  "title": "book.config.json",
  "description": "新增一本书的唯一入口。前端不写死任何书的字段，全部由此配置推导。",
  "type": "object",
  "required": ["bookId", "title", "structure", "colors", "layers", "join"],
  "additionalProperties": false,
  "properties": {
    "bookId": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "英文短名，同时是 public/data 下的目录名" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "genre": { "type": "string" },
    "structure": {
      "type": "object",
      "required": ["tree", "chunkBy", "groupSize"],
      "additionalProperties": false,
      "properties": {
        "tree": {
          "type": "array",
          "items": { "type": "string", "enum": ["volume", "chapter", "item"] },
          "minItems": 2,
          "maxItems": 3,
          "description": "目录层级。水东为 [volume,item]，新官为 [volume,chapter,item]"
        },
        "chunkBy": { "type": "string", "enum": ["volume", "chapter"] },
        "groupSize": { "type": "integer", "minimum": 1 }
      }
    },
    "colors": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "entityTypes": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/layerDecl" }
    },
    "join": {
      "type": "object",
      "required": ["layers", "primary"],
      "additionalProperties": false,
      "properties": {
        "layers": { "type": "array", "items": { "type": "string" } },
        "primary": { "type": "string" }
      }
    },
    "volProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "source": { "type": "string" }
      }
    }
  },
  "definitions": {
    "fieldDecl": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["text", "number", "enum", "ent-ref", "item-ref", "original", "link"]
        },
        "enum": { "type": "array", "items": { "type": "string" } },
        "refLayer": { "type": "string" },
        "view": { "type": "string", "enum": ["chip", "block", "hide"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["enum"] }
        }
      ]
    },
    "layerDecl": {
      "type": "object",
      "required": ["id", "label", "required"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "required": { "type": "boolean", "description": "公共必配层（ent/event）为 true" },
        "tag": { "type": "string", "description": "目录条目行尾徽标缩写，如 EN / AP / RG" },
        "reserved": { "type": "boolean", "description": "拓展要素：数据缺失时列表显示「待补建」" },
        "views": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "list": { "type": "string", "enum": ["table", "card", "tree"] },
            "detail": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["table", "timeline", "graph", "flow", "roster", "parallel", "note", "slots", "tabs"]
              }
            }
          }
        },
        "filter": { "type": "string", "enum": ["chips", "tree", "none"] },
        "filterBy": { "type": "string" },
        "groupBy": { "type": "string" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/fieldDecl" }
        }
      }
    }
  }
}
